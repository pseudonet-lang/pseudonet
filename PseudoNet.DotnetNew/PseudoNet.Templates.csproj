<Project Sdk="Microsoft.NET.Sdk">
  <!-- "dotnet new" template pack. The content\ folder is GENERATED by build-dotnet-templates.ps1 from the
       Visual Studio templates (PseudoNet.Templates\) and the compiler package: do not edit it by hand. -->
  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>PseudoNet.Templates</PackageId>
    <Version>0.1.0</Version>
    <Title>Pseudo.NET templates</Title>
    <Authors>Malek AIT OUARET</Authors>
    <Copyright>Copyright (c) 2026 Malek AIT OUARET</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>dotnet new templates for Pseudo.NET: free-form pseudocode compiled to C# by a local LLM (Ollama). PseudoCode (console), PseudrawCode (window) and six runnable samples.</Description>
    <PackageTags>dotnet-new;templates;pseudocode;teaching;LLM;Ollama</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <EnableDefaultItems>false</EnableDefaultItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://pseudonet-lang.github.io/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pseudonet-lang/pseudonet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\PseudoNet.Vsix\Resources\icon.png" Pack="true" PackagePath="" Visible="false" />
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**" PackagePath="content" />
  </ItemGroup>
</Project>
