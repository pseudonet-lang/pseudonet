<VSTemplate Version="3.0.0" Type="Project" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" xmlns:sdk="http://schemas.microsoft.com/developer/vstemplate-sdkextension/2010">
  <TemplateData>
    <Name>PseudoCode Sample - Bubble sort</Name>
    <Description>Sorts a list of numbers with the bubble sort algorithm, printing the list before and after.</Description>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>2010</SortOrder>
    <CreateNewFolder>true</CreateNewFolder>
    <PromptForSaveOnCreation>true</PromptForSaveOnCreation>
    <DefaultName>BubbleSortSample</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <CreateInPlace>true</CreateInPlace>
    <Icon>__TemplateIcon.png</Icon>
    <LanguageTag>csharp</LanguageTag>
    <PlatformTag>windows</PlatformTag>
    <ProjectTypeTag>console</ProjectTypeTag>
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="$safeprojectname$.csproj" File="BubbleSort.csproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="false" TargetFileName="Program.pseudo" OpenInEditor="true">Program.pseudo</ProjectItem>
      <Folder Name="pseudo-cache" TargetFolderName="pseudo-cache">
        <ProjectItem ReplaceParameters="false" TargetFileName="f837013ded43bb02cf32100662b4b083a17514a98a43099ae49b1675031c1692.json">f837013ded43bb02cf32100662b4b083a17514a98a43099ae49b1675031c1692.json</ProjectItem>
      </Folder>
      <Folder Name="nuget-feed" TargetFolderName="nuget-feed">
        <ProjectItem ReplaceParameters="false" TargetFileName="PseudoNet.Build.0.3.2.nupkg">PseudoNet.Build.0.3.2.nupkg</ProjectItem>
      </Folder>
    </Project>
  </TemplateContent>
</VSTemplate>
