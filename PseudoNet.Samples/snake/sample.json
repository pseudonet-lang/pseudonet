{
  "title": "Snake",
  "kind": "window",
  "language": "en",
  "mustMatch": [
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Up\\)"
    },
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Down\\)"
    },
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Left\\)"
    },
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Right\\)"
    },
    {
      "pattern": "_keysTapped\\.Contains\\(Keys\\.R\\)"
    },
    {
      "pattern": "FillRectangle",
      "min": 2
    },
    {
      "pattern": "RemoveAt\\(0\\)"
    },
    {
      "pattern": "Contains\\(new PointF"
    },
    {
      "pattern": "moveX = 1;"
    },
    {
      "pattern": "moveX = -1;"
    },
    {
      "pattern": "moveY = 1;"
    },
    {
      "pattern": "moveY = -1;"
    },
    {
      "pattern": "nx = \\(headX \\+ moveX\\)"
    },
    {
      "pattern": "ny = \\(headY \\+ moveY\\)"
    },
    {
      "pattern": "snake\\.Add\\(new PointF\\(\\(float\\)\\(nx\\), \\(float\\)\\(ny\\)\\)\\)"
    },
    {
      "pattern": "score = \\(score \\+ 1\\)"
    },
    {
      "pattern": "direction != 1"
    },
    {
      "pattern": "direction != 3"
    },
    {
      "pattern": "direction != 0"
    },
    {
      "pattern": "direction != 2"
    }
  ],
  "mustNotMatch": [
    "_timer\\.Stop\\(\\)",
    "(died|gameOver|hitWall|selfHit) != false",
    "direction \\* -1"
  ],
  "description": "Classic Snake: steer with the arrow keys, eat the apples, avoid the walls and your own tail. R restarts. Entirely free-form pseudocode."
}