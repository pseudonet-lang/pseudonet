{
  "title": "Tetris",
  "kind": "window",
  "language": "en",
  "mustMatch": [
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Left\\)"
    },
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Right\\)"
    },
    {
      "pattern": "_keysHeld\\.Contains\\(Keys\\.Down\\)"
    },
    {
      "pattern": "_keysTapped\\.Contains\\(Keys\\.Up\\)"
    },
    {
      "pattern": "_keysTapped\\.Contains\\(Keys\\.R\\)"
    },
    {
      "pattern": "FillRectangle",
      "min": 8
    },
    {
      "pattern": "TetrominoCells\\(",
      "min": 12
    },
    {
      "pattern": "!\\(gameOver\\)|gameOver != true",
      "min": 2
    }
  ],
  "mustNotMatch": [
    "gameOver (!=|==) false",
    "fell (!=|==) false"
  ],
  "description": "Tetris with coloured pieces, next-piece preview, score and sound. Arrows move (hold to repeat), Up rotates, R restarts."
}